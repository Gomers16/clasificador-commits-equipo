# Postgres (superusuario que usa la imagen postgres:16-alpine para inicializar)
POSTGRES_DB=clasificador_commits
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_admin

# Conexion de la API a la base de datos (rol app_ia creado en db/init.sql)
DB_HOST=db
DB_PORT=5432
DB_NAME=clasificador_commits
DB_USER=app_ia
DB_PASSWORD=changeme_app_ia

# Ollama (en Windows/Mac con Docker Desktop, host.docker.internal funciona nativo)
OLLAMA_URL=http://host.docker.internal:11434/api/generate
OLLAMA_MODEL=qwen2.5-coder:1.5b
